#version 450
#extension GL_EXT_shader_atomic_float : require

// Unified PMVC weight accumulation for the Ring pipeline.
//
// One dispatch consumes one or two rendered hits (depth peeling layers) of one cubemap
// and accumulates their contribution into the lambda / wsum buffers of the slot. Every
// PMVC variant goes through this shader, the differences are driven by push constants
// only:
//
//   * Set A (uBaryTexA / uDepthTexA) is the hit weighted by uHitWeightA, set B
//     (uBaryTexB / uDepthTexB) the one weighted by uHitWeightB. The three-hit variant
//     renders the first two hits into their own color images and combines them here per
//     texel, with beta negative so the second hit is subtracted from the first one on
//     the ray it belongs to. Every other configuration passes uHitWeightB = 0, which
//     skips set B entirely (its bindings then point at set A).
//   * kFlagSubtractSecondFromFirst redirects that subtraction onto the first hit instead
//     of depositing it on the second hit's own triangle. The texel then contributes
//     alpha * wA - beta * wB once, distributed over the triangle the ray hit first, so
//     beta is read as the (positive) fraction of the second hit that is taken back out
//     of the first one rather than as a signed weight of its own. Depth peeling
//     guarantees wB < wA, so for beta <= alpha the result stays positive and no cage
//     vertex ever receives negative mass; the difference is clamped at zero so an
//     over-subtraction cannot flip the ray's sign either.
//   * kFlagSolidAngleOnly selects the offset (PMVCO) weighting, which is driven by the
//     solid angle of the texel alone and has no distance term.
//   * kFlagInteriorDistance lengthens the rasterized (Euclidean) hit distance by the
//     barycentrically interpolated heat-method interior detour of the hit triangle
//     (interior distance minus Euclidean distance, zero wherever the cage is convex
//     from the mesh vertex). Where the cage is locally convex the detour vanishes and
//     the weights reduce exactly to the Euclidean variant; interpolating absolute
//     distances instead would systematically overestimate the hit distance
//     mid-triangle on coarse cages.
//
// The flags apply to both hits, so interior distances and the three-hit weights can be
// combined freely.

// Rendered barycentric + triangle index image of the first hit.
layout(binding = 0) uniform sampler2DArray uBaryTexA;

// Triangle vertex index list (3 indices per triangle).
layout(std430, binding = 1) readonly buffer VertexList {
    uint vertexList[];
};

// Output λ values (one buffer per slot).
layout(std430, binding = 2) buffer LambdaOut {
    float lambda[];
};

// Output wsum (single float per slot).
layout(std430, binding = 3) buffer WSumOut {
    float wsum[];
};

// Solid angle lookup (per face, independent of which hit is sampled).
layout(binding = 4) uniform sampler2DArray uSolidAngleTex;

// Depth cubemap of the first hit (no-hit test and base distance).
layout(binding = 5) uniform sampler2DArray uDepthTexA;

// Interior detour table: interiorDetour[meshVertexIdx * numCageVertices + cageVertexIdx]
// holds interiorDistance - euclideanDistance (>= 0) between the two vertices. Bound to
// a dummy buffer when kFlagInteriorDistance is not set.
layout(std430, binding = 6) readonly buffer InteriorDetours {
    float interiorDetour[];
};

// Second hit of the three-hit variant, bound to the first hit when unused.
layout(binding = 7) uniform sampler2DArray uBaryTexB;
layout(binding = 8) uniform sampler2DArray uDepthTexB;

layout(push_constant) uniform Params {
    ivec2 uFaceSize;        // cubemap face resolution
    int   uNumTriangles;    // number of triangles in the cage mesh
    int   uNumCageVertices; // number of cage vertices (detour table row stride)
    int   uMeshVertexIdx;   // deformable vertex this cubemap belongs to
    float uNearPlane;       // near plane of the cubemap projection
    float uFarPlane;        // far plane of the cubemap projection
    float uHitWeightA;      // weight of the first hit (1, or alpha / theta)
    float uHitWeightB;      // weight of the second hit (beta), 0 disables set B
    int   uFlags;           // see the flag constants below
} params;

const int kFlagInteriorDistance = 1;
const int kFlagSolidAngleOnly = 2;
const int kFlagSubtractSecondFromFirst = 4;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

/**
 * One hit of one texel: the cage triangle the ray landed on, the barycentric coordinates
 * of the hit point and the unweighted magnitude of its contribution (always positive).
 */
struct HitSample
{
    bool  valid;
    uvec3 indices;
    vec3  bary;
    float weight;
};

/**
 * Reads the hit of one texel out of one rendered (bary, depth) set. The hit weight of the
 * pass is deliberately not applied here so the caller can combine two hits of the same
 * texel before anything is deposited.
 */
HitSample sampleHit(vec4 tex, float depth, float solidAngle, uvec2 texel)
{
    HitSample hit;
    hit.valid = false;
    hit.indices = uvec3(0u);
    hit.bary = vec3(0.0);
    hit.weight = 0.0;

    uint tri = uint(tex.a * float(params.uNumTriangles) + 0.5);
    if (tri >= uint(params.uNumTriangles))
        return hit;

    // 1.0 means no geometry hit (clear value), which also covers the texels the depth
    // peeling pass discarded.
    if (depth >= 0.999999)
        return hit;

    uint i0 = vertexList[tri * 3 + 0];
    uint i1 = vertexList[tri * 3 + 1];
    uint i2 = vertexList[tri * 3 + 2];

    float w = solidAngle;

    if ((params.uFlags & kFlagSolidAngleOnly) == 0)
    {
        float hitDepth = depth;

        if ((params.uFlags & kFlagInteriorDistance) != 0)
        {
            // Interior detour at the hit point: the cubemap render encodes the
            // barycentric coordinates of the hit in RGB, reuse them to interpolate the
            // per-cage-vertex detours of the hit triangle.
            uint tableBase = uint(params.uMeshVertexIdx) * uint(params.uNumCageVertices);
            float detour =
                tex.r * interiorDetour[tableBase + i0] +
                tex.g * interiorDetour[tableBase + i1] +
                tex.b * interiorDetour[tableBase + i2];

            // Reconstruct the eye-space depth of the rasterized hit from the [0, 1]
            // perspective depth, lengthen the ray by the detour (eye-space depth grows
            // by detour * cos(theta) of the texel direction) and re-encode with the
            // same mapping.
            float nearPlane = params.uNearPlane;
            float farPlane = params.uFarPlane;
            float zEye = (farPlane * nearPlane) / (farPlane - depth * (farPlane - nearPlane));

            float u = (2.0 * (float(texel.x) + 0.5) / float(params.uFaceSize.x)) - 1.0;
            float v = (2.0 * (float(texel.y) + 0.5) / float(params.uFaceSize.y)) - 1.0;
            float cosTheta = inversesqrt(1.0 + u * u + v * v);
            float zEyeInterior = zEye + max(detour, 0.0) * cosTheta;

            hitDepth = clamp(
                (farPlane * (zEyeInterior - nearPlane)) / (zEyeInterior * (farPlane - nearPlane)),
                0.0, 1.0);
        }

        w = solidAngle * (1.0 - hitDepth);
    }

    if (w <= 0.0)
        return hit;

    hit.valid = true;
    hit.indices = uvec3(i0, i1, i2);
    hit.bary = tex.rgb;
    hit.weight = w;

    return hit;
}

/**
 * Deposits an already weighted contribution on the cage triangle of the hit. weight is the
 * final signed mass of the texel, so a negative one subtracts. The barycentric coordinates
 * sum to one, which keeps sum(lambda) == wsum and the normalized coordinates a partition
 * of unity no matter how the hits were combined.
 */
void emitHit(HitSample hit, float weight)
{
    if (!hit.valid || weight == 0.0)
        return;

    atomicAdd(lambda[hit.indices.x], hit.bary.r * weight);
    atomicAdd(lambda[hit.indices.y], hit.bary.g * weight);
    atomicAdd(lambda[hit.indices.z], hit.bary.b * weight);
    atomicAdd(wsum[0], weight);
}

void main()
{
    uint x    = gl_GlobalInvocationID.x;
    uint y    = gl_GlobalInvocationID.y;
    uint face = gl_GlobalInvocationID.z;

    if (x >= uint(params.uFaceSize.x) ||
        y >= uint(params.uFaceSize.y) ||
        face >= 6u)
    {
        return;
    }

    ivec3 coord = ivec3(x, y, face);
    uvec2 texel = uvec2(x, y);
    float solidAngle = texelFetch(uSolidAngleTex, coord, 0).r;

    // First hit (set A), weighted by alpha (or theta for the third hit, or 1 outside the
    // three-hit variant).
    HitSample hitA = sampleHit(
        texelFetch(uBaryTexA, coord, 0),
        texelFetch(uDepthTexA, coord, 0).r,
        solidAngle,
        texel);

    // Second hit (set B) of the same ray. Both hits of the texel are resident here, so
    // the second one meets the first one per pixel.
    if (params.uHitWeightB == 0.0)
    {
        emitHit(hitA, params.uHitWeightA * hitA.weight);

        return;
    }

    HitSample hitB = sampleHit(
        texelFetch(uBaryTexB, coord, 0),
        texelFetch(uDepthTexB, coord, 0).r,
        solidAngle,
        texel);

    if ((params.uFlags & kFlagSubtractSecondFromFirst) != 0)
    {
        // Energy preserving combination: the second hit does not get a contribution of
        // its own, it only takes mass back out of the first hit of the same ray. What is
        // removed therefore lands on the triangle that was over-counted instead of
        // becoming negative mass somewhere else in the cage.
        //
        // The second hit is peeled against the depth of the first one, so it only exists
        // where the first one does and its magnitude is always the smaller of the two;
        // the clamp only ever engages for beta > alpha (or when an interior detour
        // reorders the two hit distances).
        emitHit(hitA, max(params.uHitWeightA * hitA.weight - params.uHitWeightB * hitB.weight, 0.0));

        return;
    }

    emitHit(hitA, params.uHitWeightA * hitA.weight);
    emitHit(hitB, params.uHitWeightB * hitB.weight);
}
